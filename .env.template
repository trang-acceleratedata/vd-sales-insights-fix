# Studio-shape .env. Placeholders (`{{...}}`) are substituted by the package
# setup.sh from the active workspace's `fab api` lookup. The agent reads this
# file at runtime via `uv run --env-file .env <cmd>`. DOMAIN_SLUG and
# DBT_GIT_SHA are appended by setup.sh once the baseline commit exists.

VD_STUDIO_USER_ID=e2e-test
VD_STUDIO_TOKEN_URL={{VD_STUDIO_TOKEN_URL}}
VDFAB_INVOCATION_LOG={{WORKSPACE}}/.eval-run/fab.invocations.log
LAKEHOUSE_QUERY_INVOCATION_LOG={{WORKSPACE}}/.eval-run/lakehouse-query.invocations.log

VIRTUAL_ENV={{WORKSPACE}}/.venv
PATH={{WORKSPACE}}/.venv/bin:{{UV_DIR}}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

PROJECT_NAME=sales_insights
DESTINATION=fabric
DBT_JOB_NAME=dbt_spark_job
DBT_FABRIC_SESSION_START_TIMEOUT=1800

# --- Ephemeral (dev) workspace — agent's sandbox write surface ---
EPHEMERAL_WORKSPACE_ID={{EPHEMERAL_WORKSPACE_ID}}
EPHEMERAL_WORKSPACE_NAME={{EPHEMERAL_WORKSPACE_NAME}}
EPHEMERAL_LAKEHOUSE_ID={{EPHEMERAL_LAKEHOUSE_ID}}
EPHEMERAL_LAKEHOUSE_NAME={{EPHEMERAL_LAKEHOUSE_NAME}}
EPHEMERAL_LAKEHOUSE_SQL_ENDPOINT={{EPHEMERAL_LAKEHOUSE_SQL_ENDPOINT}}
EPHEMERAL_SCHEMA={{EPHEMERAL_SCHEMA}}

# --- Domain (prod) workspace — deployed product; read-only for the agent ---
DOMAIN_WORKSPACE_ID={{DOMAIN_WORKSPACE_ID}}
DOMAIN_WORKSPACE_NAME={{DOMAIN_WORKSPACE_NAME}}
DOMAIN_LAKEHOUSE_ID={{DOMAIN_LAKEHOUSE_ID}}
DOMAIN_LAKEHOUSE_NAME={{DOMAIN_LAKEHOUSE_NAME}}
DOMAIN_LAKEHOUSE_SQL_ENDPOINT={{DOMAIN_LAKEHOUSE_SQL_ENDPOINT}}
DOMAIN_SCHEMA={{DOMAIN_SCHEMA}}
